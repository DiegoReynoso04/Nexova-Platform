# Variables de entorno de los contenedores de Docker (ticket #infra-40), sin secretos.
# Uso: copiar a `.env` en la raíz del repositorio (ignorado por git), rellenar
# JWT_SECRET_KEY y DATABASE_URL y ejecutar `docker compose up` desde la raíz.
# Sin Docker siguen valiendo los archivos de cada app: services/api/.env y
# uis/backoffice/.env.local (ver sus .env.example y docs/local-development.md).
#
# Valores con "$": Compose interpola "$VAR" y "${VAR}" al leer este archivo, así
# que un secreto con "$" (p. ej. una contraseña de la base) puede llegar
# cambiado. Cómo escribirlo sin que se interpole está PENDIENTE de verificar en
# la fase F4 (con el motor de Docker en marcha); hasta entonces, evita "$" en
# los valores o comprueba el resultado con `docker compose config`.
#
# Rutas: usar barras "/" también en Windows.

# =============================================================================
# Servicio `api` (services/api, FastAPI). Mismas variables que services/api/.env.example.
# =============================================================================

# --- Autenticación (AUTH-01). Obligatorias: sin ellas la API no arranca. ---
# Clave de firma HS256 de los JWT, mínimo 32 caracteres. NUNCA la subas a git.
# Generar una: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
# Minutos de validez del token de acceso: entero entre 1 y 525600. El máximo
# (1 año) es un tope técnico, no una política de sesión (esa la decide el CTO).
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Inventario (Hito 5). Obligatoria: sin ella la API no arranca. ---
# Base PostgreSQL de Supabase para activos y órdenes (SQLModel). La auth sigue en TinyDB.
# Usar la cadena del "Transaction pooler" (puerto 6543) del panel de Supabase:
#   postgresql://<usuario>:<contraseña>@<host-del-pooler>:6543/postgres
# Solo se aceptan los esquemas postgresql:// y postgresql+psycopg2://.
# Contiene la contraseña de la base: NUNCA la subas a git.
# Si Supabase no responde al arrancar, la API sale con código 3 (sin la URL en el log).
DATABASE_URL=

# --- Recuperación de contraseña (AUTH-03). Opcionales: las tres juntas o ninguna. ---
# Sin ellas la API arranca, pero POST /auth/forgot-password no envía emails.
# Con solo alguna de las tres, la API no arranca (ConfigError): descomenta las tres.
# API key de Resend (https://resend.com/api-keys). NUNCA la subas a git.
# RESEND_API_KEY=
# Remitente. "onboarding@resend.dev" es el de pruebas de Resend: solo entrega
# a la dirección con la que creaste la cuenta de Resend.
# EMAIL_FROM=Nexova <onboarding@resend.dev>
# Página de restablecimiento del frontend; el enlace del email añade ?token=...
# Con Docker, el backoffice está en el puerto 3001 (en el 3000 está el website).
# PASSWORD_RESET_URL=http://localhost:3001/reset-password
# Vigencia del enlace en minutos (15-60). Por defecto 30.
# PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# Orígenes permitidos por CORS, separados por comas. Nunca "*".
# Con Docker el backoffice no lo necesita: llama a la API a través de su propio
# origen (/backend, ver API_INTERNAL_URL). Se mantienen los de siempre para las
# apps que corren fuera de Docker (3001: uis/talent-pipeline-tracker).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Límite técnico del body de la petición en bytes (1 MiB). Decisión de la API,
# no requisito del cliente. Por encima de 1 MiB Starlette puede volcar el
# archivo subido (con datos personales) a un temporal en disco.
MAX_UPLOAD_BYTES=1048576

# Archivos TinyDB (usuarios y perfiles, proveedores, gestor de incidencias).
# Por defecto: services/api/data/*.json dentro del servicio (ignorados por git).
# AUTH_DB_PATH=data/auth.json
# SUPPLIERS_DB_PATH=data/suppliers.json
# INCIDENTS_DB_PATH=data/incidents.json

# =============================================================================
# Servicio `ui` (uis/: website en el 3000 y backoffice en el 3001).
# =============================================================================

# URL de la API dentro de la red de Docker, solo para el servidor de Next: el
# backoffice reenvía /backend/* a esta dirección (rewrite de next.config.ts).
# Sin el prefijo NEXT_PUBLIC_ a propósito: así no se incorpora al JavaScript del
# navegador, que no puede resolver el nombre del servicio `api`. Sin esta
# variable (fuera de Docker) no hay rewrite y el backoffice usa las URLs
# absolutas de su .env.local. En producción se fija al construir la imagen
# (next build), no al arrancar el contenedor.
API_INTERNAL_URL=http://api:8000

# URLs base de la API que usa el navegador: la ruta /backend del propio
# backoffice, que el rewrite lleva a API_INTERNAL_URL. Se incorporan al
# JavaScript en next dev / next build (NEXT_PUBLIC_*).
NEXT_PUBLIC_API_URL=/backend
NEXT_PUBLIC_INVENTORY_API_URL=/backend

# Sondeo de cambios de next dev (backoffice). Con el código montado desde
# Windows, el contenedor no recibe avisos de cambio y sin sondeo el backoffice
# no recarga (comprobado en #infra-40). "true" o un intervalo en milisegundos.
# El website y la API no lo necesitan: el website lee cada archivo en cada
# petición y uvicorn (StatReload) ya sondea.
WATCHPACK_POLLING=true
